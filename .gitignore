scylla/data/
scylla/data/data/
scylla/data/commitlog/
scylla/data/hints/
scylla/data/view_hints/

# Keep config directories but ignore sensitive data
homeassistant/secrets.yaml
homeassistant/.uuid
homeassistant/core.*
homeassistant/entity_registry.yaml
homeassistant/device_registry.yaml
homeassistant/.google.token

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Environment variables
.env
.env.local
.env.*.local

