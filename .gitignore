**/*.pem
**/server.key
**/ca.key
mosquitto/config/*.key
mosquitto/config/ca.key
mosquitto/config/server.key

# Certificate signing requests
**/*.csr
*.csr

# Docker volumes and data
mosquitto/data/
mosquitto/log/
homeassistant/.storage/
homeassistant/deps/
homeassistant/tts/
homeassistant/home-assistant.log*
homeassistant/backups/
